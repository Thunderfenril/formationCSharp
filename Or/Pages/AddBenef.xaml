<PageFunction x:Class="Or.Pages.AddBenef"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      x:TypeArguments="sys:Int64"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Or.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddBenef">

    <Grid>
        <TextBlock x:Name="Titre" HorizontalAlignment="Left" Margin="100,85,0,0" TextWrapping="Wrap" Text="Ajout bénéficiaire" VerticalAlignment="Top" FontSize="20" FontWeight="SemiBold"/>

        <Label x:Name="labelM" Content="Numéro du compte" HorizontalAlignment="Left" Margin="100,180,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.132,-0.27"/>
        <TextBox x:Name="NCompte" HorizontalAlignment="Left" Margin="100,210,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Height="22"/>

        <Button x:Name="Retour" Content="Retour" HorizontalAlignment="Left" Margin="100,330,0,0" VerticalAlignment="Top" Height="30" Width="90" Click="Retour_Click"/>
        <Button x:Name="button" Content="Valider" HorizontalAlignment="Left" Margin="555,330,0,0" VerticalAlignment="Top" Height="30" Width="90" Click="ValiderAjout_Click"/>
    </Grid>
</PageFunction>
